# ccjournal.service — CC Journal (gunicorn). Generated by deploy.py.
[Unit]
Description=CC Journal (ccjournal) — gunicorn
After=network.target

[Service]
Type=simple
User=root
Group=root
WorkingDirectory=/opt/extra/ccjournal
Environment=DJANGO_SETTINGS_MODULE=config.settings
# Şema her başlangıçta güncellenir — migration'sız restart imkânsız.
ExecStartPre=/opt/extra/ccjournal/venv/bin/python /opt/extra/ccjournal/manage.py migrate --noinput
ExecStart=/opt/extra/ccjournal/venv/bin/gunicorn config.wsgi:application \
    --bind 0.0.0.0:9444 \
    --workers 3 \
    --timeout 60 \
    --access-logfile - --error-logfile -
Restart=on-failure
RestartSec=3
# Hardening
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
