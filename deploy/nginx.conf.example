# /etc/nginx/sites-available/ccjournal  (reverse proxy; statikler WhiteNoise'tan gelir)
server {
    listen 80;
    server_name ccjournal.example.org form.ccjournal.example.org;
    client_max_body_size 64M;          # makale dosyası yüklemeleri

    location / {
        proxy_pass         http://127.0.0.1:8000;
        proxy_set_header   Host $host;
        proxy_set_header   X-Real-IP $remote_addr;
        proxy_set_header   X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header   X-Forwarded-Proto $scheme;
    }
}
